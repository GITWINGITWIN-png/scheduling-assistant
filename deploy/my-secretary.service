# my_secretary v2 as a systemd *user* service. Installed by deploy/install.sh, which fills in
# @REPO@ and @HOST@ and writes the result to ~/.config/systemd/user/my-secretary.service.
# Commands for living with it: docs/setup/always-on.md.

[Unit]
Description=my_secretary v2 (the secretary): web page, clock and Discord bot

[Service]
Type=simple
WorkingDirectory=@REPO@/backend

# A user service starts with a near-empty PATH. v2 needs only git (B5 reads projects) and the
# usual tools: the Claude Code CLI ships inside the Agent SDK package, so no node and no ~/.nvm.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1

# The venv's uvicorn directly (not `uv run`), so a boot never waits on a dependency sync.
# install.sh runs `uv sync` beforehand. The app reads backend/.env itself (SECRETARY_* keys).
# There's deliberately no EnvironmentFile=: it would also load v1's ANTHROPIC_API_KEY.
# Host: 127.0.0.1 = this computer only. B8 adds the Tailscale address for the iPad.
ExecStart=@REPO@/backend/.venv/bin/uvicorn app.main:app --host @HOST@ --port 8000

# If it crashes, wait 5 s and start it again. A clean `systemctl --user stop` stays stopped.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
